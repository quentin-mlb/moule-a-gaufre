<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ recipe.name }}</title>
    <link href="./classicA5.css" rel="stylesheet">
</head>
<body>
    <div class="page">
        <h1>{{ recipe.name }}</h1>
        <div class="ingredients">
            <p> Pour {{ recipe.recipeYield[1] }}</p>
            <ul>
                {% for ingredient in recipe.recipeIngredient %}
                <li>{{ ingredient }}</li>
                {% endfor %}
            </ul>
        </div>

        <div class="instructions">
            <ol>
                {% for section in recipe.recipeInstructions %}
                {% for instruction in section.itemListElement %}
                <li>{{ instruction.text }}</li>
                {% endfor %}
                {% endfor %}
            </ol>
        </div>
    </div>
</body>
</html>
